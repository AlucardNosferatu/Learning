{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe build active file",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/EHsc",
                "/nologo",
                "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                "${file}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        {
            "label": "Build Pee DLL (x86)", // 任务名：x86架构（和注入器一致）
            "type": "shell",
            "command": "cl.exe", // MSVC编译器命令
            "args": [
                "/EHsc", // 异常处理
                "/LD", // 关键：编译为DLL（不是EXE）
                "/Fe:Pee.dll", // 输出DLL文件名：Pee.dll
                "/Zi", // 生成调试信息（可选）
                "Pee.cpp", // 源码文件
                "user32.lib" // 链接user32.lib（MessageBoxA依赖）
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile" // 识别MSVC编译错误
        },
        {
            "label": "Build Pee DLL (x64)", // 备用：x64架构
            "type": "shell",
            "command": "cl.exe",
            "args": [
                "/EHsc",
                "/LD",
                "/Fe:Pee_x64.dll",
                "/Zi",
                "Pee.cpp",
                "user32.lib"
            ],
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": "$msCompile"
        }
    ],
    "version": "2.0.0"
}